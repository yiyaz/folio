# Copy to .env for `pnpm dev`. Every setting is documented in docs/configuration.md.
DATABASE_URL=postgres://folio:folio@localhost:5432/folio
APP_SECRET=change-me-to-a-long-random-string-please
PUBLIC_URL=http://localhost:5173
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.data/storage
MAIL_TRANSPORT=smtp://localhost:1025
REQUIRE_EMAIL_VERIFICATION=true
SIGNUP_MODE=open

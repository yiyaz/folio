{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Folio - a collaborative plain-Markdown document editor",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @folio/server --filter @folio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "pnpm -r --if-present test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
